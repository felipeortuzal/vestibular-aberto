          }
        },
        "questionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,90}$"
          }
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "questions": {
      "type": "object",
