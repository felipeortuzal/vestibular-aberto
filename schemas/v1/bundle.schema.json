      "required": [
        "schemaVersion",
        "id",
        "canonicalId",
        "examId",
        "groupId",
        "originalNumber",
        "itemLabel",
        "format",
        "contentBlocks",
        "choices",
        "subitems",
        "sourceLocations",
        "rightsStatus",
        "rightsEvidence",
        "reviewStatus",
        "pipelineState",
        "difficulty",
        "version"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,90}$"
        },
        "canonicalId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,90}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "examId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,90}$"
        },
        "groupId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,90}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "originalNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "itemLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "enum": [
            "multiple_choice",
            "discursive",
            "numeric",
            "summation",
            "essay"
          ]
        },
        "contentBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },
        "choices": {
